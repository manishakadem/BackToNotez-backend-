@Service
public class CartDetailsServiceImpl implements CartDetailsService {

	@Autowired
	private CartDetailsDao cartDetailsDao;

	@Autowired
	private CartDao cartDao;

	@Autowired
	private ProductDao productDao;
	
	@Override
	public CartDetailsBean addCartDetails(CartDetailsBean cartDetailsBean) {
		CartDetailsEntity entity = new CartDetailsEntity();

		CartEntity cart = cartDao.findById(cartDetailsBean.getCart().getCart_id())
				.orElseThrow(() -> new RuntimeException("Cart not found"));

		ProductEntity product = productDao.findById(cartDetailsBean.getProduct().getProduct_id())
				.orElseThrow(() -> new RuntimeException("Product not found"));

		entity.setCart(cart);
		entity.setProduct(product);
		entity.setPrice(cartDetailsBean.getPrice());
		entity.setQuantity(cartDetailsBean.getQuantity());

		entity = cartDetailsDao.save(entity);

		cartDetailsBean.setCartDetails_id(entity.getCartDetails_id());
		return cartDetailsBean;
	}

