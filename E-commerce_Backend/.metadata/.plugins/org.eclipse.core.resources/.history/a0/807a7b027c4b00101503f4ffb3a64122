package com.cybage.service;

import com.cybage.bean.CartBean;
import com.cybage.dao.CartDao;
import com.cybage.dao.UserDao;
import com.cybage.entity.CartEntity;
import com.cybage.entity.UserEntity;
import org.modelmapper.ModelMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.stream.Collectors;

@Service
public class CartServiceImpl implements CartService {

	@Autowired
	private CartDao cartDao;

	@Autowired
	private UserDao userDao;

	@Autowired
	private ModelMapper modelMapper;

	@Override
	public CartBean createCart(CartBean cartBean) {
		CartEntity cartEntity = modelMapper.map(cartBean, CartEntity.class);
		cartEntity.setUser(fetchUser(cartBean.getUser().getUserId()));
		CartEntity savedEntity = cartDao.save(cartEntity);
		return modelMapper.map(savedEntity, CartBean.class);
	}

	@Override
	public List<CartBean> displaycart() {
		return cartDao.findAll().stream().map(entity -> modelMapper.map(entity, CartBean.class))
				.collect(Collectors.toList());
	}

	@Override
	public boolean deleteCart(int cartId) {
		if (cartDao.existsById(cartId)) {
			cartDao.deleteById(cartId);
			return true;
		}
		return false;
	}

	@Override
	public CartBean updateCart(CartBean cartBean) {
		if (!cartDao.existsById(cartBean.getCartId())) {
			throw new RuntimeException("Cart not found with ID: " + cartBean.getCartId());
		}

		CartEntity cartEntity = modelMapper.map(cartBean, CartEntity.class);
		cartEntity.setUser(fetchUser(cartBean.getUser().getUserId()));
		CartEntity updatedEntity = cartDao.save(cartEntity);
		return modelMapper.map(updatedEntity, CartBean.class);
	}

	private UserEntity fetchUser(int userId) {
		return userDao.findById(userId).orElseThrow(() -> new RuntimeException("User not found with ID: " + userId));
	}
	
	
}
