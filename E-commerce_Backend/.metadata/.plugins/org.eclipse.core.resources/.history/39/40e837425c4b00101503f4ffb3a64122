package com.cybage.mapper;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.BeanUtils;

import com.cybage.bean.CartBean;
import com.cybage.bean.CartDetailsBean;
import com.cybage.bean.ProductBean;
import com.cybage.bean.UserBean;
import com.cybage.entity.CartDetailsEntity;
import com.cybage.entity.CartEntity;

public class CartMapper {

	public static CartBean toBean(CartEntity cartEntity) {
		CartBean cartBean = new CartBean();
		BeanUtils.copyProperties(cartEntity, cartBean);

		UserBean userBean = new UserBean();
		BeanUtils.copyProperties(cartEntity.getUser(), userBean);
		cartBean.setUser(userBean);

		if (cartEntity.getCartDetails() != null) {
			List<CartDetailsBean> detailsBeans = new ArrayList<>();
			for (CartDetailsEntity entity : cartEntity.getCartDetails()) {
				CartDetailsBean bean = new CartDetailsBean();
				BeanUtils.copyProperties(entity, bean);

				ProductBean productBean = new ProductBean();
				BeanUtils.copyProperties(entity.getProduct(), productBean);
				bean.setProduct(productBean);

				detailsBeans.add(bean);
			}
			cartBean.setCartDetails(detailsBeans);
		}

		return cartBean;
	}
}
