package com.cybage.service;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.cybage.bean.CartBean;
import com.cybage.bean.CartDetailsBean;
import com.cybage.dao.CartDao;
import com.cybage.dao.ProductDao;
import com.cybage.dao.UserDao;
import com.cybage.entity.CartEntity;
import com.cybage.entity.CartDetailsEntity;
import com.cybage.entity.ProductEntity;
import com.cybage.entity.UserEntity;
import com.cybage.mapper.CartMapper;

@Service
public class CartServiceImpl implements CartService {

    @Autowired
    private CartDao cartDao;

    @Autowired
    private UserDao userDao;

    @Autowired
    private ProductDao productDao;

    @Override
    public CartBean createCart(CartBean cartBean) {
        // Fetch user
        UserEntity userEntity = userDao.findById(cartBean.getUser().getUserId())
                .orElseThrow(() -> new RuntimeException("User not found"));

        // Convert cart details
        List<CartDetailsEntity> cartDetailsEntities = new ArrayList<>();
        for (CartDetailsBean detailsBean : cartBean.getCartDetails()) {
            ProductEntity productEntity = productDao.findById(detailsBean.getProduct().getProductId())
                    .orElseThrow(() -> new RuntimeException("Product not found"));

            CartDetailsEntity detailsEntity = new CartDetailsEntity();
            BeanUtils.copyProperties(detailsBean, detailsEntity);
            detailsEntity.setProduct(productEntity);
            cartDetailsEntities.add(detailsEntity);
        }

        // Build CartEntity
        CartEntity cartEntity = CartMapper.toEntity(cartBean, userEntity, cartDetailsEntities);

        // Set cart reference in each cartDetailsEntity
        for (CartDetailsEntity detail : cartDetailsEntities) {
            detail.setCart(cartEntity);
        }

        CartEntity savedCart = cartDao.save(cartEntity);

        return CartMapper.toBean(savedCart);
    }

    @Override
    public List<CartBean> displayCart() {
        List<CartEntity> cartEntities = cartDao.findAll();
        List<CartBean> cartBeans = new ArrayList<>();

        for (CartEntity cartEntity : cartEntities) {
            cartBeans.add(CartMapper.toBean(cartEntity));
        }

        return cartBeans;
    }

    @Override
    public CartBean updateCart(CartBean cartBean) {
        CartEntity existingCart = cartDao.findById(cartBean.getCartId())
                .orElseThrow(() -> new RuntimeException("Cart not found with ID: " + cartBean.getCartId()));

        UserEntity userEntity = userDao.findById(cartBean.getUser().getUserId())
                .orElseThrow(() -> new RuntimeException("User not found"));

        List<CartDetailsEntity> cartDetailsEntities = new ArrayList<>();
        for (CartDetailsBean detailsBean : cartBean.getCartDetails()) {
            ProductEntity productEntity = productDao.findById(detailsBean.getProduct().getProductId())
                    .orElseThrow(() -> new RuntimeException("Product not found"));

            CartDetailsEntity detailsEntity = new CartDetailsEntity();
            BeanUtils.copyProperties(detailsBean, detailsEntity);
            detailsEntity.setProduct(productEntity);
            cartDetailsEntities.add(detailsEntity);
        }

        CartEntity updatedCart = CartMapper.toEntity(cartBean, userEntity, cartDetailsEntities);
        updatedCart.setCartId(existingCart.getCartId());

        for (CartDetailsEntity detail : cartDetailsEntities) {
            detail.setCart(updatedCart);
        }

        CartEntity savedCart = cartDao.save(updatedCart);

        return CartMapper.toBean(savedCart);
    }

    @Override
    public boolean deleteCart(int cartId) {
        if (cartDao.existsById(cartId)) {
            cartDao.deleteById(cartId);
            return true;
        }
        return false;
    }
}
