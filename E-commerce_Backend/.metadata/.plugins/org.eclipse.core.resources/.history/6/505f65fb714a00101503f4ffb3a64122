package com.cybage.mapper;

import org.springframework.beans.BeanUtils;
import org.springframework.stereotype.Component;

import com.cybage.bean.*;
import com.cybage.entity.*;

@Component
public class CartDetailsMapper {

	public CartDetailsEntity toEntity(CartDetailsBean bean, CartEntity cart, ProductEntity product) {
		return new CartDetailsEntity(0, cart, product, bean.getQuantity(), bean.getPrice());
	}

	public CartDetailsBean toBean(CartDetailsEntity entity) {
		CartDetailsBean bean = new CartDetailsBean();
		BeanUtils.copyProperties(entity, bean);

		// Set product
		ProductBean productBean = new ProductBean();
		BeanUtils.copyProperties(entity.getProduct(), productBean);
		bean.setProduct(productBean);

		// Set user
		UserBean userBean = new UserBean();
		BeanUtils.copyProperties(entity.getCart().getUser(), userBean);

		// Set cart
		CartBean cartBean = new CartBean();
		cartBean.setCartId(entity.getCart().getCartId());
		cartBean.setUser(userBean);
		bean.setCart(cartBean);

		return bean;
	}
}
