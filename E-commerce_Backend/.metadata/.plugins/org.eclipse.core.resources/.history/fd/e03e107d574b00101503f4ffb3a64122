package com.cybage.service;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.cybage.bean.WishlistBean;
import com.cybage.dao.ProductDao;
import com.cybage.dao.UserDao;
import com.cybage.dao.WishlistDao;
import com.cybage.entity.ProductEntity;
import com.cybage.entity.UserEntity;
import com.cybage.entity.WishlistEntity;
import com.cybage.mapper.WishlistMapper;

@Service
public class WishlistServiceImpl implements WishlistService {

	@Autowired
	private WishlistDao wishlistDao;

	@Autowired
	private UserDao userDao;

	@Autowired
	private ProductDao productDao;

	@Override
	public WishlistBean addWishlist(WishlistBean wishlistBean) {

		UserEntity user = userDao.findById(wishlistBean.getUser().getUserId())
				.orElseThrow(() -> new RuntimeException("User not found"));
		ProductEntity product = productDao.findById(wishlistBean.getProduct().getProductId())
				.orElseThrow(() -> new RuntimeException("Product not found"));

		WishlistEntity wishlistEntity = WishlistMapper.toEntity(wishlistBean, user, product);
		WishlistEntity savedEntity = wishlistDao.save(wishlistEntity);
		return WishlistMapper.toBean(savedEntity);
	}

	@Override
	public List<WishlistBean> displayWishlist() {

		List<WishlistBean> wishlistBeanList = new ArrayList<>();
		for (WishlistEntity wishlistEntity : wishlistDao.findAll()) {
			wishlistBeanList.add(WishlistMapper.toBean(wishlistEntity));
		}
		return wishlistBeanList;
	}

	@Override
	public boolean deleteWishlist(int id) {

		if (wishlistDao.existsById(id)) {
			wishlistDao.deleteById(id);
			return true;
		} else {
			return false;
		}
	}

	@Override
	public WishlistBean updateWishlist(WishlistBean wishlistBean) {

		WishlistEntity existingEntity = wishlistDao.findById(wishlistBean.getWishlistId())
				.orElseThrow(() -> new RuntimeException("Wishlist not found"));

		UserEntity user = userDao.findById(wishlistBean.getUser().getUserId())
				.orElseThrow(() -> new RuntimeException("User not found"));
		ProductEntity product = productDao.findById(wishlistBean.getProduct().getProductId())
				.orElseThrow(() -> new RuntimeException("Product not found"));

		WishlistEntity updatedEntity = WishlistMapper.toEntity(wishlistBean, user, product);
		updatedEntity.setWishlistId(existingEntity.getWishlistId()); // maintain existing ID

		return WishlistMapper.toBean(wishlistDao.save(updatedEntity));
	}
}
