	@Override
	public List<CartDetailsBean> displayCartDetails() {
		
	    List<CartDetailsBean> cartDetailsBeanList = new ArrayList<>();
	    List<CartDetailsEntity> cartDetailsEntityList = cartDetailsDao.findAll();

	    for (CartDetailsEntity cartDetailsEntity : cartDetailsEntityList) {
	        CartDetailsBean cartDetailsBean = new CartDetailsBean();
	        BeanUtils.copyProperties(cartDetailsEntity, cartDetailsBean);

	        // Set CartBean
	        CartBean cartBean = new CartBean();
	        BeanUtils.copyProperties(cartDetailsEntity.getCart(), cartBean);

	        // Set UserBean inside CartBean
	        UserBean userBean = new UserBean();
	        BeanUtils.copyProperties(cartDetailsEntity.getCart().getUser(), userBean);
	        cartBean.setUser(userBean);

	        cartDetailsBean.setCart(cartBean);

	        // Set ProductBean
	        ProductBean productBean = new ProductBean();
	        BeanUtils.copyProperties(cartDetailsEntity.getProduct(), productBean);
	        cartDetailsBean.setProduct(productBean);

	        cartDetailsBeanList.add(cartDetailsBean);
	    }

	    return cartDetailsBeanList;
	}


