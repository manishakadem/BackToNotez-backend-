	@Override
	public CartDetailsBean addCartDetails(CartDetailsBean cartDetailsBean) {
		// Fetch CartEntity and ProductEntity directly
		CartEntity managedCart = cartDao.findById(cartDetailsBean.getCart().getCartId()).orElseThrow(
				() -> new RuntimeException("Cart not found with ID: " + cartDetailsBean.getCart().getCartId()));

		ProductEntity managedProduct = productDao.findById(cartDetailsBean.getProduct().getProductId())
				.orElseThrow(() -> new RuntimeException(
						"Product not found with ID: " + cartDetailsBean.getProduct().getProductId()));

		// Save CartDetailsEntity
		CartDetailsEntity savedEntity = cartDetailsDao.save(new CartDetailsEntity(0, managedCart, managedProduct,
				cartDetailsBean.getQuantity(), cartDetailsBean.getPrice()));

		// Prepare response bean
		CartDetailsBean responseBean = new CartDetailsBean();
		BeanUtils.copyProperties(savedEntity, responseBean);

		// Set cart bean
		CartBean cartBean = new CartBean();
		BeanUtils.copyProperties(savedEntity.getCart(), cartBean);

		UserBean userBean = new UserBean();
		BeanUtils.copyProperties(savedEntity.getCart().getUser(), userBean);
		cartBean.setUser(userBean);

		responseBean.setCart(cartBean);

		// Set product bean
		ProductBean productBean = new ProductBean();
		BeanUtils.copyProperties(savedEntity.getProduct(), productBean);
		responseBean.setProduct(productBean);

		return responseBean;
	}
