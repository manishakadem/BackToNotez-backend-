package com.cybage.service;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.BeanUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.cybage.bean.CategoryBean;
import com.cybage.bean.ProductBean;
import com.cybage.dao.CategoryDao;
import com.cybage.dao.ProductDao;
import com.cybage.entity.CategoryEntity;
import com.cybage.entity.ProductEntity;

@Service
public class ProductServiceImpl implements ProductService {

	@Autowired
	private ProductDao productDao;

	@Autowired
	private CategoryDao categoryDao;

	@Override
	public ProductBean addProduct(ProductBean productBean) {
		// Fetch CategoryEntity directly
		CategoryEntity managedCategory = categoryDao.findById(productBean.getCategory().getCategory_id())
				.orElseThrow(() -> new RuntimeException(
						"Category not found with ID: " + productBean.getCategory().getCategory_id()));

		// Save ProductEntity
		ProductEntity savedEntity = productDao.save(new ProductEntity(0, productBean.getProduct_name(),
				productBean.getProduct_description(), productBean.getProduct_price(),
				productBean.getProduct_stock_quantity(), productBean.getProduct_imageUrl(), managedCategory));

		// Prepare response bean
		ProductBean responseBean = new ProductBean();
		BeanUtils.copyProperties(savedEntity, responseBean);

		// Set CategoryBean
		CategoryBean categoryBean = new CategoryBean();
		BeanUtils.copyProperties(savedEntity.getCategory(), categoryBean);
		responseBean.setCategory(categoryBean);

		return responseBean;
	}


	@Override
	public List<ProductBean> displayProducts() {
		
		List<ProductBean> productBeanList = new ArrayList<>();
		List<ProductEntity> productEntityList = productDao.findAll();

		for (ProductEntity productEntity : productEntityList) {
			ProductBean productBean = new ProductBean();
			BeanUtils.copyProperties(productEntity, productBean);

			// Set CategoryBean
			CategoryBean categoryBean = new CategoryBean();
			BeanUtils.copyProperties(productEntity.getCategory(), categoryBean);
			productBean.setCategory(categoryBean);

			productBeanList.add(productBean);
		}

		return productBeanList;
	}


	
	@Override
	public ProductBean updateProduct(ProductBean productBean) {
	    // Fetch existing product from the database using productBean's ID
	    ProductEntity existingProduct = productDao.findById(productBean.getProduct_id())
	            .orElseThrow(() -> new RuntimeException("Product not found with ID: " + productBean.getProduct_id()));

	    // Update fields while preserving the existing entity's ID
	    BeanUtils.copyProperties(productBean, existingProduct, "product_id");

	    // Fetch and update category
	    CategoryEntity managedCategory = categoryDao.findById(productBean.getCategory().getCategory_id())
	            .orElseThrow(() -> new RuntimeException("Category not found with ID: " + productBean.getCategory().getCategory_id()));
	    existingProduct.setCategory(managedCategory);

	    // Save updated product entity
	    ProductEntity updatedProduct = productDao.save(existingProduct);

	    // Convert updated entity back to ProductBean
	    ProductBean responseBean = new ProductBean();
	    BeanUtils.copyProperties(updatedProduct, responseBean);

	    // Set CategoryBean
	    CategoryBean categoryBean = new CategoryBean();
	    BeanUtils.copyProperties(updatedProduct.getCategory(), categoryBean);
	    responseBean.setCategory(categoryBean);

	    return responseBean;
	}

	

	@Override
	public boolean deleteProduct(int id) {
		if (productDao.existsById(id)) {
			productDao.deleteById(id);
			return true;
		} else {
			return false;
		}
	}

}
