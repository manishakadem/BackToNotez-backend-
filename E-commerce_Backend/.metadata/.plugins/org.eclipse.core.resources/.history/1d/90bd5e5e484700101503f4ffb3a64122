package com.cybage.service;

import java.util.ArrayList;
import java.util.List;

import org.springframework.beans.BeanUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.cybage.bean.CartBean;
import com.cybage.bean.UserBean;
import com.cybage.dao.CartDao;
import com.cybage.dao.UserDao;
import com.cybage.entity.CartEntity;
import com.cybage.entity.UserEntity;

@Service
public class CartServiceImpl implements CartService {

	@Autowired
	private CartDao cartDao;

	@Autowired
	private UserDao userDao;

	@Override
	public CartBean createCart(CartBean cartBean) {
		CartEntity cartEntity = new CartEntity();

		int userId = cartBean.getUser().getUserId();
		UserEntity managedUser = userDao.findById(userId)
				.orElseThrow(() -> new RuntimeException("User not found with ID: " + userId));

		cartEntity.setUser(managedUser);
		CartEntity savedEntity = cartDao.save(cartEntity);

		CartBean responseBean = new CartBean();
		responseBean.setCart_id(savedEntity.getCart_id());

		UserBean userBean = new UserBean();
		BeanUtils.copyProperties(savedEntity.getUser(), userBean);
		responseBean.setUser(userBean);

		return responseBean;

	}

	@Override
	public List<CartBean> displaycart() {
		List<CartBean> listCartBean = new ArrayList<>();
		List<CartEntity> listCartEntity = cartDao.findAll();

		for (CartEntity cartEntity : listCartEntity) {
			CartBean cartBean = new CartBean();

			// Copy basic properties
			BeanUtils.copyProperties(cartEntity, cartBean);

			// Convert UserEntity to UserBean manually
			UserEntity userEntity = cartEntity.getUser();
			if (userEntity != null) {
				UserBean userBean = new UserBean(userEntity.getUserId(), userEntity.getName(), userEntity.getEmail(),
						userEntity.getPassword(), userEntity.getContact());
				cartBean.setUser(userBean);
			}

			listCartBean.add(cartBean);
		}
		return listCartBean;
	}

}
