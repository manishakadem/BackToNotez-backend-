	@Override
    public CartBean createCart(CartBean cartBean) {
        CartEntity cartEntity = new CartEntity();

        int userId = cartBean.getUser().getUserId();
        UserEntity managedUser = userDao.findById(userId)
                .orElseThrow(() -> new RuntimeException("User not found with ID: " + userId));

        cartEntity.setUser(managedUser);
        CartEntity savedEntity = cartDao.save(cartEntity);

        CartBean responseBean = new CartBean();
        responseBean.setCart_id(savedEntity.getCart_id());

        UserBean userBean = new UserBean();
        BeanUtils.copyProperties(savedEntity.getUser(), userBean);
        responseBean.setUser(userBean);

        return responseBean;
    }

	@Override
	public List<CartBean> displaycart() {
		List<CartBean> listCartBean = null;
		List<CartEntity> listCartEntity = cartDao.findAll();
		if (listCartEntity != null) {
			listCartBean = new ArrayList<>();
			for (CartEntity cartEntity : listCartEntity) {
				CartBean cartbean = new CartBean();
				BeanUtils.copyProperties(cartEntity, cartbean);
				listCartBean.add(cartbean);

			}
		}
		return listCartBean;

	}

