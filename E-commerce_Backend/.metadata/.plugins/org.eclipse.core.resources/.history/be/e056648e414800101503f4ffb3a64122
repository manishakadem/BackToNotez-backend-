package com.cybage.service;

import java.util.List;
import java.util.stream.Collectors;

import org.springframework.beans.BeanUtils;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.cybage.bean.CartBean;
import com.cybage.bean.UserBean;
import com.cybage.dao.CartDao;
import com.cybage.dao.UserDao;
import com.cybage.entity.CartEntity;
import com.cybage.entity.UserEntity;

@Service
public class CartServiceImpl implements CartService {

	@Autowired
	private CartDao cartDao;

	@Autowired
	private UserDao userDao;

	@Override
	public CartBean createCart(CartBean cartBean) {

		UserEntity userEntity = userDao.findById(cartBean.getUser().getUserId())
				.orElseThrow(() -> new RuntimeException("User not found with ID: " + cartBean.getUser().getUserId()));

		CartEntity savedEntity = cartDao.save(new CartEntity(0, userEntity));

		UserBean userBean = new UserBean();
		BeanUtils.copyProperties(savedEntity.getUser(), userBean);

		return new CartBean(savedEntity.getCart_id(), userBean);
	}

	@Override
	public List<CartBean> displaycart() {
		return cartDao.findAll().stream().map(cartEntity -> {
			UserEntity userEntity = cartEntity.getUser();
			UserBean userBean = (userEntity != null)
					? new UserBean(userEntity.getUserId(), userEntity.getName(), userEntity.getEmail(),
							userEntity.getPassword(), userEntity.getContact())
					: null;

			return new CartBean(cartEntity.getCart_id(), userBean);
		}).collect(Collectors.toList());
	}

}
